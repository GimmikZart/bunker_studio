NODE_ENV=development
# This file lives at the repository root and is loaded by both the web app and
# the worker. Real environment variables always win over it.
#
# Persistence follows the configuration, not where the app runs: set SUPABASE_URL
# and SUPABASE_ANON_KEY and the studio uses that project, whether it is the local
# Docker one or a cloud one. Only the data location differs.
# Leave BUNKER_PERSISTENCE_MODE unset for that. Set it to "memory" to force the
# throwaway in-process store (tests, or a first look with no database).
BUNKER_PERSISTENCE_MODE=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
STUDIO_MASTER_KEY=
SUPABASE_URL=http://127.0.0.1:55421
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55422/postgres
WEB_PORT=3000
WORKER_HEARTBEAT_INTERVAL_MS=60000
WORKER_CONTROL_PLANE_URL=http://localhost:3000
WORKER_REGISTRATION_TOKEN=
WORKER_IDENTITY_FILE=.bunker/worker-identity.json
WORKER_WORKSPACE_ROOT=.bunker/workspaces
WORKER_CODEX_NETWORK_ACCESS=false
# Comma-separated executable basenames. Commands run without a shell and with a secret-free env.
WORKER_ALLOWED_VERIFICATION_EXECUTABLES=pnpm,npm,yarn,bun,node
WORKER_NAME=Bunker local worker
WORKER_CAPABILITIES=chat,repository,codex
WORKER_TASK_POLL_INTERVAL_MS=2000
AGENT_CHAT_ESTIMATED_COST=0.01
# Cost booked per Lead planning run, per meeting turn and per design request.
# These gate the budget policy before any provider call is made.
LEAD_PLAN_ESTIMATED_COST=0.05
MEETING_CONTRIBUTION_ESTIMATED_COST=0.01
DESIGN_PROPOSAL_ESTIMATED_COST=0.02

# Provider API keys and model IDs are intentionally not environment variables.
# Add each provider account in the app, then select provider/model/runtime per agent.
